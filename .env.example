# Azure AI Foundry project & model deployment
PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>
MODEL_DEPLOYMENT_NAME=gpt-5.6-luna

# Optional: only needed for scripts/test_llm.py direct OpenAI endpoint smoke test
API_KEY=

# Azure Service Principal credentials (used by DefaultAzureCredential in Docker / CI / local if not using `az login`)
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

